@model IEnumerable<VKart.ModelsLayer.DTOs.OrderDto>
@{
    ViewData["Title"] = "My Orders";
}

<h3 class="fw-bold mb-4"><i class="bi bi-receipt me-2"></i>My Orders</h3>

@if (!Model.Any())
{
    <div class="text-center py-5 bg-white rounded-4 shadow-sm">
        <i class="bi bi-box display-1 text-muted mb-3"></i>
        <h4>No orders yet</h4>
        <p class="text-muted mb-4">You haven't placed any orders.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-vcart">Start Shopping</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var order in Model)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-bottom-0 pt-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small">Order ID</span>
                            <h6 class="fw-bold mb-0">#@order.OrderId</h6>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small">Placed on</span>
                            <div class="small fw-semibold">@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div>
                                <span class="badge @(order.OrderStatusText == "Delivered" ? "bg-success" : order.OrderStatusText == "Cancelled" ? "bg-danger" : "bg-primary") rounded-pill px-3 py-2 mb-2">
                                    @order.OrderStatusText
                                </span>
                                <div class="small text-muted">@order.Items.Sum(i => i.Quantity) item(s) | Total: <strong>₹@order.TotalAmount.ToString("N0")</strong></div>
                            </div>

                            <div>
                                <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-vcart">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
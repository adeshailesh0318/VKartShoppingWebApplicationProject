@model VKart.ModelsLayer.DTOs.OrderDto
@{
    ViewData["Title"] = $"Order #{Model.OrderId}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Order Details</h3>
    <a asp-action="Index" class="btn btn-outline-vcart btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Orders</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Items</h5>
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <div>
                            <h6 class="fw-semibold mb-1">@item.ProductName</h6>
                            <span class="text-muted small">Qty: @item.Quantity × ₹@item.UnitPrice.ToString("N0")</span>
                        </div>
                        <span class="fw-bold">₹@item.LineTotal.ToString("N0")</span>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <span class="fs-5 fw-bold">Total Amount</span>
                    <span class="fs-4 fw-bold text-dark">₹@Model.TotalAmount.ToString("N0")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">Order Info</h6>
                <div class="mb-3">
                    <span class="text-muted small d-block">Order ID</span>
                    <span class="fw-semibold">#@Model.OrderId</span>
                </div>
                <div class="mb-3">
                    <span class="text-muted small d-block">Date</span>
                    <span class="fw-semibold">@Model.OrderDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="mb-3">
                    <span class="text-muted small d-block">Status</span>
                    <span class="badge bg-primary rounded-pill mt-1">@Model.OrderStatusText</span>
                </div>
                <div>
                    <span class="text-muted small d-block mb-1">Shipping Address</span>
                    <p class="small bg-light p-2 rounded">@Model.ShippingAddress</p>
                </div>
            </div>
        </div>
    </div>
</div>
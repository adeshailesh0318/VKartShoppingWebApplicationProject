@model VKart.PresentationLayer.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "All Products";
}

<div class="row">
    <!-- Sidebar Filters -->
    <div class="col-md-3 mb-4">
        <div class="card border-0 shadow-sm rounded-4 p-3">
            <h6 class="fw-bold mb-3"><i class="bi bi-funnel me-2"></i>Filters</h6>

            <form method="get" asp-action="Index">
                <!-- Keep search and sort hidden so we don't lose them on filter -->
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="sortBy" value="@Model.SortBy" />

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Category</label>
                    <select name="categoryId" class="form-select" onchange="this.form.submit()">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">
                                @cat.CategoryName
                            </option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Product Grid -->
    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <span>Search results for "@Model.Search"</span>
                }
                else
                {
                    <span>All Products</span>
                }
                <span class="text-muted fs-6 fw-normal">(@Model.Products.Count() items)</span>
            </h5>

            <!-- Sort Dropdown -->
            <form method="get" asp-action="Index" class="d-flex align-items-center">
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />

                <label class="me-2 small text-muted text-nowrap">Sort by:</label>
                <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="newest" selected="@(Model.SortBy == "newest" || string.IsNullOrEmpty(Model.SortBy))">Newest</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                    <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name: A to Z</option>
                </select>
            </form>
        </div>

        @if (!Model.Products.Any())
        {
            <div class="alert alert-info text-center py-5">
                <i class="bi bi-search display-4 text-muted mb-3 d-block"></i>
                <h5>No products found</h5>
                <p class="mb-0">Try adjusting your search or filters.</p>
                <a asp-action="Index" class="btn btn-outline-vcart mt-3">Clear Filters</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var p in Model.Products)
                {
                    <div class="col-6 col-lg-4">
                        <div class="card product-card">
                            <img src="@(p.ImageUrl ?? "https://via.placeholder.com/300x200?text=Product")" alt="@p.ProductName" />
                            <div class="card-body d-flex flex-column">
                                <span class="badge-category mb-2 d-inline-block">@p.CategoryName</span>
                                <h6 class="card-title fw-semibold mb-1 text-truncate">@p.ProductName</h6>
                                <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                                    <span class="price-text">₹@p.Price.ToString("N0")</span>
                                    <a class="btn btn-sm btn-vcart" asp-action="Details" asp-route-id="@p.ProductId">
                                        View
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
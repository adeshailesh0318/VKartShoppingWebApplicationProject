@model VKart.PresentationLayer.ViewModels.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.ProductName;
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
        <li class="breadcrumb-item active">@Model.Product.ProductName</li>
    </ol>
</nav>

<div class="row bg-white p-4 rounded-4 shadow-sm">
    <!-- Image -->
    <div class="col-md-5 mb-4 mb-md-0 text-center">
        <img src="@(Model.Product.ImageUrl ?? "https://via.placeholder.com/400x400?text=Product")"
             class="img-fluid rounded-3" alt="@Model.Product.ProductName" style="max-height: 400px; object-fit: contain;">
    </div>

    <!-- Details -->
    <div class="col-md-7">
        <span class="badge-category mb-2">@Model.Product.CategoryName</span>
        <h2 class="fw-bold mb-2">@Model.Product.ProductName</h2>

        <div class="d-flex align-items-center mb-3">
            <h3 class="text-warning fw-bold mb-0 me-3">₹@Model.Product.Price.ToString("N0")</h3>
            @if (Model.Product.StockQuantity > 0)
            {
                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3">In Stock (@Model.Product.StockQuantity)</span>
            }
            else
            {
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3">Out of Stock</span>
            }
        </div>

        <p class="text-muted mb-4 lead" style="font-size: 1.1rem;">@Model.Product.Description</p>

        <hr />

        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (Model.Product.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="mt-4 row g-3 align-items-center">
                    <input type="hidden" name="productId" value="@Model.Product.ProductId" />

                    <div class="col-auto">
                        <label class="col-form-label fw-semibold">Quantity:</label>
                    </div>
                    <div class="col-auto">
                        <input type="number" name="quantity" class="form-control" value="1" min="1" max="@Model.Product.StockQuantity" style="width: 100px;" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-vcart btn-lg px-4">
                            <i class="bi bi-cart-plus me-2"></i>Add to Cart
                        </button>
                    </div>
                </form>
            }
            else
            {
                <button class="btn btn-secondary btn-lg mt-4 px-4" disabled>Out of Stock</button>
            }
        }
        else
        {
            <div class="alert alert-warning mt-4">
                Please <a asp-controller="Account" asp-action="Login" class="fw-bold">Login</a> to add items to your cart.
            </div>
        }
    </div>
</div>
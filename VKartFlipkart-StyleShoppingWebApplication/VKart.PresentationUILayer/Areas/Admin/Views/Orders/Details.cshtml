@model VKart.ModelsLayer.DTOs.OrderDto
@using VKart.ModelsLayer.Enums
@{
    ViewData["Title"] = $"Order #{Model.OrderId}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Order #@Model.OrderId</h4>
        <p class="text-muted small mb-0">Placed on @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-vcart btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">Items</h6>
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@(item.ImageUrl ?? "https://via.placeholder.com/60?text=Img")" class="rounded bg-light" style="width:60px; height:60px; object-fit:contain;" />
                            <div>
                                <div class="fw-semibold">@item.ProductName</div>
                                <div class="text-muted small">₹@item.UnitPrice.ToString("N0") × @item.Quantity</div>
                            </div>
                        </div>
                        <span class="fw-bold">₹@item.LineTotal.ToString("N0")</span>
                    </div>
                }
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <span class="fs-5 fw-bold">Total</span>
                    <span class="fs-4 fw-bold">₹@Model.TotalAmount.ToString("N0")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">Customer</h6>
                <div class="fw-semibold">@Model.CustomerName</div>
                <div class="text-muted small">@Model.CustomerEmail</div>
                <hr />
                <div class="text-muted small mb-1">Shipping Address:</div>
                <p class="small bg-light p-2 rounded">@Model.ShippingAddress</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">Update Status</h6>
                <div class="mb-3">
                    <span class="text-muted small d-block mb-2">Current Status</span>
                    <span class="badge bg-primary rounded-pill px-3 py-2">@Model.OrderStatusText</span>
                </div>
                <form asp-action="UpdateStatus" asp-route-id="@Model.OrderId" method="post">
                    <label class="form-label small fw-semibold">Change to:</label>
                    <select name="status" class="form-select mb-3">
                        @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                        {
                            // FIX: Compare the enums directly
                            if (s == Model.OrderStatus)
                            {
                                <option value="@((int)s)" selected>@s</option>
                            }
                            else
                            {
                                <option value="@((int)s)">@s</option>
                            }
                        }
                    </select>
                    <button type="submit" class="btn btn-vcart w-100">Update Status</button>
                </form>
            </div>
        </div>
    </div>
</div>
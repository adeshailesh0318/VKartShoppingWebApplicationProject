@model IEnumerable<VKart.ModelsLayer.DTOs.ProductDto>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Product Management</h4>
    <!-- Add Area explicitly -->
    <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-vcart">
        <i class="bi bi-plus-circle me-1"></i>Add Product
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="text-muted small">
                        <th class="ps-4">Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://picsum.photos/200" : p.ImageUrl)"
                                         class="rounded bg-light me-2" style="width:40px; height:40px; object-fit:contain;" />
                                    <div>
                                        <div class="fw-semibold">@p.ProductName</div>
                                        <div class="text-muted small">ID: @p.ProductId</div>
                                    </div>
                                </div>
                            </td>
                            <td>@p.CategoryName</td>
                            <td>₹@p.Price.ToString("N0")</td>
                            <td>
                                @if (p.StockQuantity == 0)
                                {
                                    <span class="badge bg-danger">Out</span>
                                }
                                else if (p.StockQuantity <= 10)
                                {
                                    <span class="badge bg-warning text-dark">@p.StockQuantity left</span>
                                }
                                else
                                {
                                    <span>@p.StockQuantity</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(p.IsActive ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">
                                    @(p.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <!-- Edit Link -->
                                <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <!-- Delete Form -->
                                <form asp-area="Admin" asp-controller="Products" asp-action="Delete" asp-route-id="@p.ProductId" method="post" class="d-inline" onsubmit="return confirm('Delete this product?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model IEnumerable<VKart.ModelsLayer.Entities.ApplicationUser>
@{
    ViewData["Title"] = "Customers";
}

<h4 class="fw-bold mb-4">Registered Customers</h4>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="text-muted small">
                        <th class="ps-4">Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Joined Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@c.FullName</td>
                            <td>@c.Email</td>
                            <td>@(c.MobileNumber ?? "N/A")</td>
                            <td class="text-muted small">@c.CreatedDate.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No customers registered yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
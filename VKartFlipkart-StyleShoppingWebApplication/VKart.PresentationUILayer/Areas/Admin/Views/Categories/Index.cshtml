@model IEnumerable<VKart.ModelsLayer.DTOs.CategoryDto>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Category Management</h4>
    <a asp-action="Create" class="btn btn-vcart"><i class="bi bi-plus-circle me-1"></i>Add Category</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="text-muted small">
                        <th class="ps-4">Category</th>
                        <th>Description</th>
                        <th>Products</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@c.CategoryName</td>
                            <td class="text-muted small">@c.Description</td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary">@c.ProductCount</span></td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category? Products will lose category reference.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model VKart.ModelsLayer.DTOs.CreateCategoryDto
@{
    var isEdit = ViewContext.RouteData.Values["action"]?.ToString() == "Edit";
    ViewData["Title"] = isEdit ? "Edit Category" : "Add Category";
}

<h4 class="fw-bold mb-4">@ViewData["Title"]</h4>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="row g-3" style="max-width: 600px;">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

            <div class="col-12">
                <label asp-for="CategoryName" class="form-label fw-semibold">Category Name *</label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-vcart px-4"><i class="bi bi-check-circle me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}